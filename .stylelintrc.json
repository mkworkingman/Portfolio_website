{
    "extends": ["stylelint-config-standard-scss", "stylelint-config-recess-order"],
    "rules": {
        "order/order": [
            "dollar-variables",
            "custom-properties",
            {
                "type": "at-rule",
                "hasBlock": false
            },
            "declarations",
            "rules",
            {
                "type": "at-rule",
                "hasBlock": true
            }
        ]
    }
}
